# ── Database ──────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/knowledgehub
DB_USER=knowledgehub
DB_PASS=knowledgehub

# ── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
# Set to true when using Upstash (requires TLS)
REDIS_TLS=false

# ── JWT ────────────────────────────────────────────────────
# Must be >= 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-secret-min-32-characters

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── AI Providers ───────────────────────────────────────────
AI_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# OpenAI (required for prod)
OPENAI_API_KEY=sk-...

# Google Gemini (optional for dev)
GEMINI_API_KEY=

# Ollama (local dev — no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# ── Storage ────────────────────────────────────────────────
# Use 'local' for development, 's3' for production
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# ── AWS S3 (required when STORAGE_TYPE=s3) ─────────────────
S3_BUCKET=knowledgehub-uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Google OAuth2 (optional) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
